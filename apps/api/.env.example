PORT=3000
NODE_ENV=development

# Auth: "dev" = local login without Cognito (token is the email). Use "cognito" on AWS.
AUTH_MODE=dev
DEV_ADMIN_EMAILS=admin@smartbin.local

# AWS Cognito Auth Configuration (ignored when AUTH_MODE=dev)
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
MOBILE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# "off" skips the AI photo check for local runs. Use "openai" (needs OPENAI_API_KEY) or "bedrock" for real checks.
VISION_PROVIDER=off
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL=gpt-4.1-mini
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
S3_BUCKET_NAME=smartbin-uploads-bucket
# "local" keeps photos in apps/api/.local-uploads (no AWS needed). Use "s3" on AWS.
STORAGE_MODE=local
# For the Expo app on a phone, set this to your PC\'s LAN address, e.g. http://192.168.1.10:3000
# API_PUBLIC_URL=http://localhost:3000

# Defaults only: admins can change these from the dashboard (PUT /v1/admin/settings)
QUOTA_LIMIT_REGISTRATIONS=10
QUOTA_LIMIT_MISSING_REPORTS=15
MISSING_REPORTS_THRESHOLD=3

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/smartbin

# CORS configuration
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
